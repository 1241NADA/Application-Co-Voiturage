<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f9f9f9;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AjouterTrajetCourtController">
   <children>
      <!-- Conteneur Principal -->
      <VBox layoutX="20.0" layoutY="10.0" spacing="20" style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10;">
         <!-- Formulaire -->
         <VBox spacing="15">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #b42c1a;" text="Ajouter un Trajet Court" />
            
            <VBox spacing="10">
               <Label style="-fx-text-fill: #333333; -fx-font-size: 12px;" text="Point De Depart:" />
               <TextField fx:id="tfpd" style="-fx-background-color: #f5f5f5; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />
               
               <Label style="-fx-text-fill: #333333; -fx-font-size: 12px;" text="Destination:" />
               <TextField fx:id="tfd" style="-fx-background-color: #f5f5f5; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />
               
               <Label style="-fx-text-fill: #333333; -fx-font-size: 12px;" text="Date:" />
               <TextField fx:id="tfdt" style="-fx-background-color: #f5f5f5; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />
               
               <Label style="-fx-text-fill: #333333; -fx-font-size: 12px;" text="Heure:" />
               <TextField fx:id="tfh" style="-fx-background-color: #f5f5f5; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />
               
               <Label style="-fx-text-fill: #333333; -fx-font-size: 12px;" text="Nombre de Places Disponibles:" />
               <TextField fx:id="tfnpd" style="-fx-background-color: #f5f5f5; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />
               
               <Label style="-fx-text-fill: #333333; -fx-font-size: 12px;" text="Nom de Conducteur:" />
               <TextField fx:id="tfnc" style="-fx-background-color: #f5f5f5; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />
               
               <Label style="-fx-text-fill: #333333; -fx-font-size: 12px;" text="Type de Voiture:" />
               <TextField fx:id="tfv" style="-fx-background-color: #f5f5f5; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />
            </VBox>
            
            <!-- Boutons -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
               <Button onAction="#ClickedEnregistrer" style="-fx-background-color: #b42c1a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Enregistrer" />
               <Button onAction="#ClickedSupprimer" style="-fx-background-color: #b42c1a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Supprimer" />
            </HBox>
         </VBox>

         <!-- TableView -->
         <TableView fx:id="tableTrajets" prefHeight="87.0" prefWidth="760.0" style="-fx-border-color: #b42c1a; -fx-border-radius: 10;">
            <columns>
               <TableColumn fx:id="colDepart" prefWidth="120.0" text="Point de Depart" />
               <TableColumn fx:id="colDestination" prefWidth="120.0" text="Destination" />
               <TableColumn fx:id="colDate" prefWidth="100.0" text="Date" />
               <TableColumn fx:id="colHeure" prefWidth="100.0" text="Heure" />
               <TableColumn fx:id="colPlaces" prefWidth="150.0" text="Places Disponibles" />
               <TableColumn fx:id="colConducteur" prefWidth="120.0" text="Nom Conducteur" />
               <TableColumn fx:id="colVoiture" prefWidth="120.0" text="Type de Voiture" />
            </columns>
         </TableView>
      </VBox>
   </children>
</AnchorPane>
