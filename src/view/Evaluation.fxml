<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.EvaluationController">
   <stylesheets>
      <URL value="@evaluation.css" />
   </stylesheets>
   <children>
      <!-- Section Utilisateur et Commentaire -->
      <VBox layoutX="-1.0" prefHeight="142.0" prefWidth="600.0" spacing="15.0">
         <!-- Label Utilisateur -->
         <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #c11212;" text="Utilisateur">
            <padding>
               <Insets left="20.0" />
            </padding>
         </Label>
         <TextField fx:id="tfu" prefHeight="26.0" prefWidth="463.0" style="-fx-border-color: #c11212; -fx-border-radius: 5px; -fx-padding: 5px;" />

         <!-- Label Commentaire -->
         <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #c11212;" text="Commentaire :">
            <VBox.margin>
               <Insets left="20.0" />
            </VBox.margin>
         </Label>
         <TextField fx:id="tfc" prefHeight="26.0" prefWidth="463.0" style="-fx-border-color: #c11212; -fx-border-radius: 5px; -fx-padding: 5px;" />
      </VBox>

      <!-- Section Slider et ProgressIndicator -->
      <FlowPane alignment="CENTER" layoutX="34.0" layoutY="169.0" prefHeight="123.0" prefWidth="534.0" vgap="20.0">
         <!-- Slider -->
         <Slider fx:id="Slider" max="100" min="0" showTickLabels="true" showTickMarks="true" style="-fx-background-color: #f1f8e8; -fx-border-radius: 10px; -fx-font-size: 12px;" value="0" />
         
         <!-- ProgressIndicator -->
         <ProgressIndicator fx:id="Indicateur" progress="0.0" style="-fx-progress-color: #c11212;" />
      </FlowPane>

      <!-- Section Boutons -->
      <HBox alignment="CENTER" layoutY="277.0" prefHeight="123.0" prefWidth="616.0" spacing="50.0">
         <!-- Bouton Enregistrer -->
         <Button mnemonicParsing="false" onAction="#ClickedEnregistrer" style="-fx-background-color: #c11212; -fx-text-fill: white; -fx-padding: 10px 20px; -fx-border-radius: 5px; -fx-font-size: 14px;" text="Enregistrer" />
      </HBox>
   </children>
</AnchorPane>
