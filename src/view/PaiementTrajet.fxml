<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PaiementTrajetController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="20.0" prefHeight="400.0" prefWidth="600.0">
         <!-- Titre -->
         <Label text="Paiement d'un Trajet" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c11212;" />

         <!-- Formulaire de saisie -->
         <VBox spacing="10.0" alignment="CENTER_LEFT">
            <!-- Montant -->
            <HBox spacing="10.0">
               <Label text="Montant :" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <TextField fx:id="tfm" prefWidth="300.0" style="-fx-border-color: #c11212; -fx-border-radius: 5px;" />
            </HBox>

            <!-- Mode de paiement -->
            <HBox spacing="10.0">
               <Label text="Mode de paiement :" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <TextField fx:id="tfmp" prefWidth="300.0" style="-fx-border-color: #c11212; -fx-border-radius: 5px;" />
            </HBox>

            <!-- Date de paiement -->
            <HBox spacing="10.0">
               <Label text="Date de paiement :" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <TextField fx:id="tfdp" prefWidth="300.0" style="-fx-border-color: #c11212; -fx-border-radius: 5px;" />
            </HBox>
         </VBox>

         <!-- TableView pour afficher les paiements enregistrés -->
         <TableView fx:id="tablePaiements" prefWidth="550.0" prefHeight="150.0">
            <columns>
               <!-- Colonne Montant -->
               <TableColumn fx:id="colMontant" text="Montant" prefWidth="150.0" />
               <!-- Colonne Mode de paiement -->
               <TableColumn fx:id="colModePaiement" text="Mode de Paiement" prefWidth="150.0" />
               <!-- Colonne Date de paiement -->
               <TableColumn fx:id="colDatePaiement" text="Date de Paiement" prefWidth="150.0" />
            </columns>
         </TableView>

         <!-- Boutons -->
         <HBox alignment="CENTER" spacing="50.0">
            <Button text="Enregistrer" onAction="#ClickedEnregistre" prefWidth="120.0" prefHeight="40.0"
                    style="-fx-background-color: #c11212; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5px;" />
            <Button text="Supprimer" onAction="#ClickedSupprimer" prefWidth="120.0" prefHeight="40.0"
                    style="-fx-background-color: #c11212; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5px;" />
         </HBox>
      </VBox>
   </children>
</AnchorPane>
