<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f3f3f3;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AjouterTrajetLongController">
   <children>
      <VBox layoutX="0.0" layoutY="0.0" prefHeight="666.0" prefWidth="800.0" spacing="10" style="-fx-padding: 20;">
         <!-- Formulaire de saisie -->
         <children>
            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b42c1a;" text="Point De Depart:">
               <padding>
                  <Insets left="20.0" />
               </padding>
            </Label>
            <TextField fx:id="tfpd" prefHeight="26.0" prefWidth="463.0" style="-fx-background-color: white; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />

            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b42c1a;" text="Destination:">
               <VBox.margin>
                  <Insets left="20.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="tfd" prefHeight="26.0" prefWidth="523.0" style="-fx-background-color: white; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />

            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b42c1a;" text="Date:">
               <padding>
                  <Insets left="20.0" />
               </padding>
            </Label>
            <TextField fx:id="tfdt" style="-fx-background-color: white; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />

            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b42c1a;" text="Heure:">
               <padding>
                  <Insets left="20.0" />
               </padding>
            </Label>
            <TextField fx:id="tfh" style="-fx-background-color: white; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />

            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b42c1a;" text="Nombre de Places Disponibles:">
               <padding>
                  <Insets left="20.0" />
               </padding>
            </Label>
            <TextField fx:id="tfnpd" style="-fx-background-color: white; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />

            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b42c1a;" text="Nom de conducteur:">
               <padding>
                  <Insets left="20.0" />
               </padding>
            </Label>
            <TextField fx:id="tfnc" style="-fx-background-color: white; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />

            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #b42c1a;" text="Distance:">
               <padding>
                  <Insets left="20.0" />
               </padding>
            </Label>
            <TextField fx:id="tfdis" style="-fx-background-color: white; -fx-border-color: #b42c1a; -fx-border-radius: 5;" />

            <!-- Boutons centrés -->
            <HBox alignment="CENTER" spacing="40.0" style="-fx-padding: 10;">
               <children>
                  <Button mnemonicParsing="false" onAction="#ClickedEnregistrer" style="-fx-background-color: linear-gradient(to bottom, #b42c1a, #ff5733); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" text="Enregistrer" />
                  <Button mnemonicParsing="false" onAction="#ClickedSupprimer" style="-fx-background-color: linear-gradient(to bottom, #b42c1a, #ff5733); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" text="Supprimer" />
               </children>
            </HBox>

            <!-- TableView pour afficher les trajets -->
            <TableView fx:id="tableTrajets" prefHeight="300.0" prefWidth="760.0" style="-fx-border-color: #b42c1a; -fx-border-radius: 5;">
               <columns>
                  <TableColumn fx:id="colDepart" prefWidth="100.0" text="Point de Départ" />
                  <TableColumn fx:id="colDestination" prefWidth="100.0" text="Destination" />
                  <TableColumn fx:id="colDate" prefWidth="100.0" text="Date" />
                  <TableColumn fx:id="colHeure" prefWidth="100.0" text="Heure" />
                  <TableColumn fx:id="colPlaces" prefWidth="80.0" text="Places" />
                  <TableColumn fx:id="colConducteur" prefWidth="100.0" text="Conducteur" />
                  <TableColumn fx:id="colDistance" prefWidth="100.0" text="Distance" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
